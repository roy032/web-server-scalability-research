{
  "name": "web-server-scalability-research",
  "version": "2.0.0",
  "description": "Industry-grade web server parallel scalability research with Docker, monitoring, and comprehensive benchmarking",
  "main": "src/server-basic.js",
  "scripts": {
    "start": "node src/server-basic.js",
    "start:cluster": "node src/server-cluster.js",
    "start:express": "node src/server-express.js",
    "start:ml": "node src/ml-server.js",
    "start:ml-cluster": "cross-env CLUSTER=true node src/ml-server.js",
    "start:all": "node scripts/start-all-servers.js",
    "dev": "nodemon src/server-basic.js",
    "all": "concurrently -n basic,cluster,express \"npm:start\" \"npm:start:cluster\" \"npm:start:express\"",
    "test": "jest --coverage --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:integration": "jest --testMatch='**/*.integration.test.js'",
    "benchmark": "node benchmarks/run-benchmarks.js",
    "benchmark:export": "node benchmarks/run-benchmarks.js --export",
    "visualize": "python scripts/generate-graphs.py",
    "lint": "eslint src tests benchmarks",
    "lint:fix": "eslint src tests benchmarks --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "prepare": "husky install || true",
    "precommit": "lint-staged",
    "docs:api": "jsdoc -c jsdoc.json",
    "clean": "rimraf coverage dist node_modules/.cache"
  },
  "keywords": [
    "web-server",
    "scalability",
    "parallel-computing",
    "nginx",
    "nodejs",
    "express",
    "cluster-mode",
    "load-testing",
    "performance-analysis",
    "benchmarking",
    "docker",
    "microservices",
    "academic-research",
    "machine-learning-inference"
  ],
  "author": {
    "name": "Research Team",
    "email": "research@example.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/web-server-scalability-research.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/web-server-scalability-research/issues"
  },
  "homepage": "https://github.com/yourusername/web-server-scalability-research#readme",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "prom-client": "^15.1.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.2",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}

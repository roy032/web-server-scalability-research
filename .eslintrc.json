{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": [
    "airbnb-base",
    "prettier"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "no-plusplus": "off",
    "no-await-in-loop": "off",
    "no-restricted-syntax": "off",
    "consistent-return": "off",
    "no-param-reassign": ["error", { "props": false }]
  },
  "ignorePatterns": ["node_modules/", "coverage/", "dist/", "results/", "logs/"]
}
